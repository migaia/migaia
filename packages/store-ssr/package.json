{
  "name": "@migaia/store-ssr",
  "version": "0.0.1",
  "private": true,
  "description": "Request-scoped Store SSR dehydration and hydration.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "USEGUIDE.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "sideEffects": false,
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test"
  },
  "dependencies": {
    "@migaia/utils": "workspace:^",
    "@migaia/reactive": "workspace:^",
    "@migaia/resource": "workspace:^",
    "@migaia/serialize": "workspace:^"
  },
  "devDependencies": { "typescript": "~6.0.2", "vitest": "4.1.10" }
}
