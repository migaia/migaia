{
  "name": "@migaia/store-ssr",
  "version": "0.0.2",
  "private": true,
  "description": "Request-scoped Store SSR dehydration and hydration.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/reactive": "workspace:^",
    "@migaia/resource": "workspace:^",
    "@migaia/serialize": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
