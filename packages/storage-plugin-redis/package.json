{
  "name": "@migaia/storage-plugin-redis",
  "version": "0.0.0",
  "private": true,
  "description": "Native Redis and Valkey storage backend",
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ioredis": {
      "types": "./dist/adapters/ioredis.d.ts",
      "default": "./dist/ioredis.js"
    },
    "./node-redis": {
      "types": "./dist/adapters/node-redis.d.ts",
      "default": "./dist/node-redis.js"
    },
    "./bun": {
      "types": "./dist/adapters/bun.d.ts",
      "default": "./dist/bun.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "lint": "oxlint src test",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && vite build && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/dist-stamp.mjs write",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@migaia/serialize": "workspace:^",
    "@migaia/storage-contract": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "ioredis": "6.0.0",
    "redis": "6.3.0"
  },
  "peerDependencies": {
    "@migaia/storage-host": "workspace:^",
    "ioredis": "^6.0.0",
    "redis": "^6.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
