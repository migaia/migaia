{
  "name": "@migaia/logger",
  "version": "0.0.7",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/logger"
  },
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fmt": "oxfmt src test e2e logger.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "lint": "oxlint src test e2e logger.test.ts",
    "test": "pnpm run build && vitest run test logger.test.ts",
    "test:coverage": "pnpm run build && vitest run --coverage test logger.test.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/event-subscriber": "workspace:^",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@migaia/utils": "workspace:^",
    "ansis": "4.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
