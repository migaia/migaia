{
  "name": "@migaia/rpc-bridge-jsonrpc",
  "version": "0.0.7",
  "private": true,
  "description": "RPC bridge-jsonrpc owner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/rpc-bridge-jsonrpc"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/bridge/jsonrpc/index.d.ts",
      "default": "./dist/bridge/jsonrpc/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/dist-stamp.mjs clean && node ../../scripts/dist-stamp.mjs build-rpc && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks",
    "fmt": "oxfmt src test vitest.config.ts",
    "lint": "oxlint src test vitest.config.ts",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@migaia/utils": "workspace:^"
  },
  "peerDependencies": {
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/rpc-core": "workspace:*",
    "@migaia/rpc-process": "workspace:*"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@types/node": "24.13.2",
    "cborg": "6.1.1",
    "elysia": "1.4.30",
    "msgpackr": "2.1.0",
    "protobufjs": "8.8.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/rpc-core": "workspace:*",
    "@migaia/rpc-process": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
