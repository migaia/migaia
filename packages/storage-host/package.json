{
  "name": "@migaia/storage-host",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-neutral storage host and typed backend authoring",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/storage-host"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./journal": {
      "types": "./dist/journal.d.ts",
      "default": "./dist/journal.js"
    },
    "./plugins/probe": {
      "types": "./dist/plugins/probe/index.d.ts",
      "default": "./dist/plugins/probe.js"
    },
    "./entity": {
      "types": "./dist/entity.d.ts",
      "default": "./dist/entity.js"
    },
    "./authoring/vector": {
      "types": "./dist/authoring/vector.d.ts",
      "default": "./dist/authoring/vector.js"
    },
    "./vector/mmr": {
      "types": "./dist/vector/mmr.d.ts",
      "default": "./dist/vector/mmr.js"
    },
    "./authoring/backend": {
      "types": "./dist/authoring/backend.d.ts",
      "default": "./dist/authoring/backend.js"
    },
    "./authoring/migration": {
      "types": "./dist/authoring/migration.d.ts",
      "default": "./dist/authoring/migration.js"
    },
    "./authoring/codec": {
      "types": "./dist/authoring/codec.d.ts",
      "default": "./dist/authoring/codec.js"
    },
    "./authoring/concurrency": {
      "types": "./dist/authoring/concurrency.d.ts",
      "default": "./dist/authoring/concurrency.js"
    },
    "./authoring/transaction": {
      "types": "./dist/authoring/transaction.d.ts",
      "default": "./dist/authoring/transaction.js"
    },
    "./authoring/query": {
      "types": "./dist/authoring/query.d.ts",
      "default": "./dist/authoring/query.js"
    },
    "./authoring/sql": {
      "types": "./dist/authoring/sql.d.ts",
      "default": "./dist/authoring/sql.js"
    },
    "./authoring/key": {
      "types": "./dist/authoring/key.d.ts",
      "default": "./dist/authoring/key.js"
    },
    "./authoring/resource": {
      "types": "./dist/authoring/resource.d.ts",
      "default": "./dist/authoring/resource.js"
    },
    "./authoring/context": {
      "types": "./dist/authoring/context.d.ts",
      "default": "./dist/authoring/context.js"
    },
    "./authoring/rdf": {
      "types": "./dist/authoring/rdf.d.ts",
      "default": "./dist/authoring/rdf.js"
    },
    "./authoring/sparql": {
      "types": "./dist/authoring/sparql.d.ts",
      "default": "./dist/authoring/sparql.js"
    },
    "./authoring/ttl": {
      "types": "./dist/authoring/ttl.d.ts",
      "default": "./dist/authoring/ttl.js"
    },
    "./authoring/counter": {
      "types": "./dist/authoring/counter.d.ts",
      "default": "./dist/authoring/counter.js"
    },
    "./authoring/blob": {
      "types": "./dist/authoring/blob.d.ts",
      "default": "./dist/authoring/blob.js"
    },
    "./authoring/store": {
      "types": "./dist/authoring/store.d.ts",
      "default": "./dist/authoring/store.js"
    },
    "./authoring/capability": {
      "types": "./dist/authoring/capability.d.ts",
      "default": "./dist/authoring/capability.js"
    },
    "./entity/query": {
      "types": "./dist/entity/query.d.ts",
      "default": "./dist/entity/query.js"
    },
    "./entity/unique": {
      "types": "./dist/entity/unique.d.ts",
      "default": "./dist/entity/unique.js"
    },
    "./entity/migration": {
      "types": "./dist/entity/migration.d.ts",
      "default": "./dist/entity/migration.js"
    },
    "./entity/indexes": {
      "types": "./dist/entity/indexes.d.ts",
      "default": "./dist/entity/indexes.js"
    },
    "./entity/keyset": {
      "types": "./dist/entity/keyset.d.ts",
      "default": "./dist/entity/keyset.js"
    },
    "./authoring/change-controller": {
      "types": "./dist/authoring/change-controller.d.ts",
      "default": "./dist/authoring/change-controller.js"
    },
    "./authoring/change-iterator": {
      "types": "./dist/authoring/change-iterator.d.ts",
      "default": "./dist/authoring/change-iterator.js"
    },
    "./features/memory-notifications": {
      "types": "./dist/features/memory-notifications.d.ts",
      "default": "./dist/features/memory-notifications.js"
    },
    "./features/memory-change-feed": {
      "types": "./dist/features/memory-change-feed.d.ts",
      "default": "./dist/features/memory-change-feed.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "fmt": "oxfmt src test README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && vite build && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "pnpm run build && vitest run",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks",
    "test:packed": "pnpm run build && node test/authoring-packed-export-smoke.mjs"
  },
  "dependencies": {
    "@migaia/event-subscriber": "workspace:^",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@migaia/serialize": "workspace:^",
    "@migaia/storage-contract": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@migaia/logger": "workspace:^"
  },
  "peerDependencies": {
    "@migaia/logger": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@migaia/logger": {
      "optional": true
    }
  }
}
