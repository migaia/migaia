{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migaia.dev/rpc/protocol.schema.json",
  "title": "migaia.rpc/2 semantic protocol",
  "$comment": "Self-contained JSON projection of rpc-contract ./protocol. Native binary/carrier extension shells are separate boundaries. Preserve object own-key order during encode/decode; schema does not sort data. JSON Schema checks representable structural constraints only; authoritative pure validators enforce all semantic admission. Fixed protocol records ignore unknown fields (core BC9); portable byte tags and method-schema definitions retain their own admission rules.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/accept"
    },
    {
      "$ref": "#/$defs/admissionPending"
    },
    {
      "$ref": "#/$defs/reject"
    },
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/group"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/stream"
    },
    {
      "$ref": "#/$defs/outcomeFrame"
    },
    {
      "$ref": "#/$defs/control"
    },
    {
      "$ref": "#/$defs/directoryFrame"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "object",
      "required": ["kind", "value", "providerId"],
      "properties": {
        "kind": {
          "enum": ["restart", "session"]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["applicationVersion", "senderId", "targetId", "receiverId", "sentAt"],
      "properties": {
        "applicationVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "receiverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sentAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "forwardRoute": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "minItems": 2,
          "maxItems": 17
        },
        "remainingMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647
        },
        "trace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "portable": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/portable"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "const": "$rpc"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/portable"
          }
        },
        {
          "type": "object",
          "required": ["$rpc", "base64url"],
          "properties": {
            "$rpc": {
              "const": "bytes"
            },
            "base64url": {
              "type": "string",
              "pattern": "^([A-Za-z0-9_-]{4})*([A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "methodSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "anyOf": [
            {
              "enum": ["null", "boolean", "object", "array", "number", "integer", "string"]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["null", "boolean", "object", "array", "number", "integer", "string"]
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/methodSchema"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "items": {
          "$ref": "#/$defs/methodSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portable"
          }
        },
        "const": {
          "$ref": "#/$defs/portable"
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/methodSchema"
          }
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/methodSchema"
          }
        },
        "$ref": {
          "type": "string",
          "pattern": "^#/[\\$]defs/"
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "peer": {
      "type": "object",
      "required": ["id", "runtime"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "runtimeVersion": {
          "type": "string",
          "maxLength": 64
        },
        "implementation": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        }
      }
    },
    "extension": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
    },
    "extensionList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/extension"
      },
      "additionalProperties": {
        "$ref": "#/$defs/portable"
      }
    },
    "codec": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,31}$"
    },
    "directory": {
      "type": "object",
      "required": ["schemaVersion", "self", "methods"],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "self": {
          "type": "object",
          "required": ["name", "instanceId", "generation"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "$ref": "#/$defs/generation"
            }
          }
        },
        "methods": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": ["name", "supportedModes", "modeSource"],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}(\\.[A-Za-z][A-Za-z0-9_-]{0,39})*$"
              },
              "supportedModes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": ["request", "notify", "stream"]
                }
              },
              "modeSource": {
                "enum": ["declared", "generated-routes"]
              },
              "idempotent": {
                "type": "boolean"
              },
              "forwardedVia": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
              },
              "input": {
                "$ref": "#/$defs/methodSchema"
              },
              "output": {
                "$ref": "#/$defs/methodSchema"
              },
              "yield": {
                "$ref": "#/$defs/methodSchema"
              }
            }
          }
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "$comment": "Method names must be unique; local method-schema references and semantic budgets are checked by the pure directory validator."
    },
    "nodeIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "errorNode": {
      "type": "object",
      "required": ["source", "code", "name", "message", "stack"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "stack": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "$ref": "#/$defs/nodeIndex"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nodeIndex"
          }
        },
        "data": {
          "$ref": "#/$defs/portable"
        },
        "route": {
          "type": "array",
          "minItems": 1,
          "maxItems": 17,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        },
        "truncated": {
          "const": true
        }
      }
    },
    "errorGraph": {
      "type": "object",
      "required": ["root", "nodes"],
      "properties": {
        "root": {
          "$ref": "#/$defs/nodeIndex"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/errorNode"
          }
        }
      },
      "$comment": "Each root/cause/errors index must be less than nodes.length. Shared and cyclic indexes are allowed. Scalar UTF-8/surrogate and total error byte budgets require normalizeRpcWireError."
    },
    "task": {
      "type": "object",
      "required": ["mode", "callerId", "callerGeneration", "targetGeneration"],
      "properties": {
        "mode": {
          "enum": ["request", "notify", "stream", "group", "outcome"]
        },
        "callerId": {
          "$ref": "#/$defs/identifier"
        },
        "callerGeneration": {
          "$ref": "#/$defs/generation"
        },
        "targetGeneration": {
          "$ref": "#/$defs/generation"
        }
      },
      "if": {
        "properties": {
          "mode": {
            "enum": ["request", "notify", "stream"]
          }
        }
      },
      "then": {
        "required": ["method"],
        "properties": {
          "method": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "options": {
      "type": "object",
      "required": [],
      "properties": {
        "orderKey": {
          "$ref": "#/$defs/identifier"
        },
        "cancel": {
          "const": "before-start"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:~-]{1,128}$"
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "$ref": "#/$defs/identifier"
        },
        "payload": {
          "$ref": "#/$defs/portable"
        }
      }
    },
    "groupResult": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stepOutcome"
      },
      "$comment": "Pure validator enforces success prefix, at most one first failure, and exact not-executed suffix."
    },
    "stepOutcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "const": "success"
            },
            "result": {
              "$ref": "#/$defs/portable"
            }
          }
        },
        {
          "type": "object",
          "required": ["state", "error"],
          "properties": {
            "state": {
              "const": "failure"
            },
            "error": {
              "$ref": "#/$defs/errorGraph"
            }
          }
        },
        {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "const": "not-executed"
            }
          }
        }
      ]
    },
    "completion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok"],
          "not": {
            "required": ["streamTerminal"]
          },
          "properties": {
            "ok": {
              "const": true
            },
            "result": {
              "$ref": "#/$defs/portable"
            }
          }
        },
        {
          "type": "object",
          "required": ["ok", "error"],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/errorGraph"
            },
            "streamTerminal": {
              "const": "cancelled"
            }
          }
        }
      ]
    },
    "groupCompletion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "result"],
          "properties": {
            "ok": {
              "const": true
            },
            "result": {
              "$ref": "#/$defs/groupResult"
            }
          }
        },
        {
          "type": "object",
          "required": ["ok", "error"],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/errorGraph"
            }
          }
        }
      ]
    },
    "streamEvent": {
      "oneOf": [
        {
          "type": "object",
          "required": ["event", "seq"],
          "properties": {
            "event": {
              "const": "open"
            },
            "seq": {
              "const": 0
            }
          }
        },
        {
          "type": "object",
          "required": ["event", "seq"],
          "properties": {
            "event": {
              "const": "pull"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "required": ["event", "seq", "value"],
          "properties": {
            "event": {
              "const": "item"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "value": {
              "$ref": "#/$defs/portable"
            }
          }
        },
        {
          "type": "object",
          "required": ["event", "seq"],
          "properties": {
            "event": {
              "const": "end"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "value": {
              "$ref": "#/$defs/portable"
            }
          }
        },
        {
          "type": "object",
          "required": ["event", "seq", "error"],
          "properties": {
            "event": {
              "const": "fail"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "error": {
              "$ref": "#/$defs/errorGraph"
            }
          }
        },
        {
          "type": "object",
          "required": ["event", "seq"],
          "properties": {
            "event": {
              "const": "cancelled"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "error": {
              "$ref": "#/$defs/errorGraph"
            }
          }
        },
        {
          "type": "object",
          "required": ["event", "seq"],
          "properties": {
            "event": {
              "const": "finish-without-items"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reason": {
              "$ref": "#/$defs/errorGraph"
            }
          }
        }
      ],
      "$comment": "Sequence progression, credits, terminal state and max item byte budget are checked by pure stream helpers and StreamChannel, not by this event shape alone."
    },
    "store": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "epoch", "continuity"],
          "properties": {
            "kind": {
              "enum": ["memory", "external"]
            },
            "epoch": {
              "type": "string",
              "minLength": 1
            },
            "continuity": {
              "enum": ["retained", "lost-since-restart"]
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "continuity"],
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "continuity": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "outcome": {
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "stream"
              }
            }
          },
          "else": {
            "properties": {
              "completion": {
                "not": {
                  "required": ["streamTerminal"]
                }
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "targetGeneration", "completion"],
          "properties": {
            "mode": {
              "enum": ["request", "notify", "stream"]
            },
            "targetGeneration": {
              "$ref": "#/$defs/generation"
            },
            "completion": {
              "$ref": "#/$defs/completion"
            }
          }
        },
        {
          "type": "object",
          "required": ["mode", "targetGeneration", "completion"],
          "properties": {
            "mode": {
              "const": "group"
            },
            "targetGeneration": {
              "$ref": "#/$defs/generation"
            },
            "completion": {
              "$ref": "#/$defs/groupCompletion"
            }
          }
        }
      ]
    },
    "hello": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "step",
        "versions",
        "codecs",
        "extensions",
        "peer",
        "directory"
      ],
      "properties": {
        "profile": {
          "const": "migaia.rpc/2"
        },
        "kind": {
          "const": "handshake"
        },
        "step": {
          "const": "hello"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "codecs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "contains": {
            "const": "json"
          },
          "items": {
            "$ref": "#/$defs/codec"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensionList"
        },
        "requiredExtensions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/extension"
              },
              {
                "maxLength": 128
              }
            ]
          }
        },
        "peer": {
          "$ref": "#/$defs/peer"
        },
        "directory": {
          "$ref": "#/$defs/directory"
        },
        "auth": {
          "$ref": "#/$defs/portable"
        }
      },
      "$comment": "Distinct offered major versions, requiredExtensions subset, and directory.self.instanceId === peer.id are checked by normalizeRpcHandshake. Negotiation must use actual installed handler offers."
    },
    "accept": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "step",
        "major",
        "minor",
        "codec",
        "extensions",
        "peer",
        "directory"
      ],
      "properties": {
        "profile": {
          "const": "migaia.rpc/2"
        },
        "kind": {
          "const": "handshake"
        },
        "step": {
          "const": "accept"
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "codec": {
          "$ref": "#/$defs/codec"
        },
        "extensions": {
          "$ref": "#/$defs/extensionList"
        },
        "peer": {
          "$ref": "#/$defs/peer"
        },
        "directory": {
          "$ref": "#/$defs/directory"
        },
        "auth": {
          "$ref": "#/$defs/portable"
        }
      },
      "$comment": "Shape admission is separate from completing an actual offer. completeRpcHandshake enforces supported major2/minor0 and offered codec/extension/required membership."
    },
    "admissionPending": {
      "type": "object",
      "required": ["profile", "kind", "step", "peer", "remainingMs"],
      "properties": {
        "profile": { "const": "migaia.rpc/2" },
        "kind": { "const": "handshake" },
        "step": { "const": "pending" },
        "peer": { "$ref": "#/$defs/peer" },
        "remainingMs": { "type": "number", "minimum": 0, "maximum": 2147483647 },
        "auth": { "$ref": "#/$defs/portable" }
      },
      "$comment": "Only an already negotiated physical peer may extend waiting into name admission. Repeated pending notices cannot refresh the Session-owned admission deadline."
    },
    "reject": {
      "type": "object",
      "required": ["profile", "kind", "step", "error"],
      "properties": {
        "profile": {
          "const": "migaia.rpc/2"
        },
        "kind": {
          "const": "handshake"
        },
        "step": {
          "const": "reject"
        },
        "error": {
          "$ref": "#/$defs/errorGraph"
        }
      }
    },
    "call": {
      "type": "object",
      "required": ["profile", "kind", "id", "route", "task", "options"],
      "properties": {
        "profile": {
          "const": "migaia.rpc/2"
        },
        "kind": {
          "const": "call"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "task": {
          "allOf": [
            {
              "$ref": "#/$defs/task"
