{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migaia.dev/rpc/runtime-description.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "self",
    "methods"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "self": {
      "type": "object",
      "required": [
        "name",
        "instanceId"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "methods": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "name",
          "supportedModes",
          "modeSource"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}(\\.[A-Za-z][A-Za-z0-9_-]{0,39})*$"
          },
          "supportedModes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "request",
                "notify",
                "stream"
              ]
            }
          },
          "modeSource": {
            "enum": [
              "declared",
              "generated-routes"
            ]
          },
          "idempotent": {
            "type": "boolean"
          },
          "forwardedVia": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"
          }
        }
      }
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
