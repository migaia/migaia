{
  "name": "@migaia/rpc-contract",
  "version": "0.0.11",
  "private": true,
  "description": "RPC contract owner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/rpc-contract"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/wire/index.d.ts",
      "default": "./dist/wire/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "default": "./dist/interfaces/index.js"
    },
    "./portable": {
      "types": "./dist/portable/index.d.ts",
      "default": "./dist/portable/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./error-code": {
      "types": "./dist/error-code.d.ts",
      "default": "./dist/error-code.js"
    },
    "./schema/wire-error": {
      "default": "./schema/wire-error.schema.json"
    },
    "./schema/protocol": {
      "default": "./schema/protocol.schema.json"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks",
    "fmt": "oxfmt src test vitest.config.ts README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "lint": "oxlint src test vitest.config.ts",
    "test": "vitest run --coverage",
    "typecheck:contract": "bun check -p tsconfig.contract.json"
  },
  "dependencies": {
    "@migaia/serialize": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "cborg": "6.1.1",
    "elysia": "1.4.30",
    "msgpackr": "2.1.0",
    "protobufjs": "8.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {},
  "engines": {
    "node": ">=18"
  }
}
