{
  // Whole-package source typecheck against the ES library only: no DOM and no Node types, so no
  // public declaration can depend on a host environment. Host globals every supported runtime has
  // come from `packages/utils/types/host-globals.d.ts`. Tests use `tsconfig.test.json`, which adds
  // their own environment and test types.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "ESNext.Disposable"],
    "module": "esnext",
    "types": [],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../utils/types/host-globals.d.ts"],
  // Redeclares AbortController/AbortSignal/etc. globally — collides with the
  // real ones from `lib.dom.d.ts` in this config (unlike the core proof,
  // which has no DOM lib to collide with).
  "exclude": []
}
