{
  "name": "@migaia/web-rpc",
  "version": "0.0.4",
  "private": true,
  "description": "Type-safe bidirectional RPC — schema-typed method/params/result with transport-agnostic endpoints. No dependency on Store, React, WASM, or any specific host (DOM/Node).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/web-rpc"
  },
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "default": "./dist/full.js"
    },
    "./features/outbound": {
      "types": "./dist/features/outbound.d.ts",
      "default": "./dist/features/outbound.js"
    },
    "./features/provider": {
      "types": "./dist/features/provider.d.ts",
      "default": "./dist/features/provider.js"
    },
    "./features/discovery": {
      "types": "./dist/features/discovery.d.ts",
      "default": "./dist/features/discovery.js"
    },
    "./features/control": {
      "types": "./dist/features/control.d.ts",
      "default": "./dist/features/control.js"
    },
    "./features/chunk": {
      "types": "./dist/features/chunk.d.ts",
      "default": "./dist/features/chunk.js"
    },
    "./protocol-constants": {
      "types": "./dist/protocol-constants.d.ts",
      "default": "./dist/protocol-constants.js"
    },
    "./adapters/window": {
      "types": "./dist/adapters/window.d.ts",
      "default": "./dist/adapters/window.js"
    },
    "./adapters/message-port": {
      "types": "./dist/adapters/message-port.d.ts",
      "default": "./dist/adapters/message-port.js"
    },
    "./adapters/web-worker": {
      "types": "./dist/adapters/web-worker.d.ts",
      "default": "./dist/adapters/web-worker.js"
    },
    "./adapters/broadcast-channel": {
      "types": "./dist/adapters/broadcast-channel.d.ts",
      "default": "./dist/adapters/broadcast-channel.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "default": "./dist/adapters/memory.js"
    },
    "./adapters/shared-worker": {
      "types": "./dist/adapters/shared-worker.d.ts",
      "default": "./dist/adapters/shared-worker.js"
    },
    "./adapters/service-worker": {
      "types": "./dist/adapters/service-worker.d.ts",
      "default": "./dist/adapters/service-worker.js"
    },
    "./adapters/rtc-data-channel": {
      "types": "./dist/adapters/rtc-data-channel.d.ts",
      "default": "./dist/adapters/rtc-data-channel.js"
    },
    "./adapters/web-transport": {
      "types": "./dist/adapters/web-transport.d.ts",
      "default": "./dist/adapters/web-transport.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "fmt": "oxfmt src test e2e",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "typecheck:node-adapter": "tsc --noEmit -p tsconfig.node-adapter.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint src test e2e",
    "test": "vitest run test --coverage",
    "test:tree-shaking-baseline": "node test/tree-shaking-baseline.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:packed": "pnpm build && node test/packed-export-smoke.mjs && node test/packed-provider-authority.mjs && node test/packed-d95-boundary.mjs",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/capability": "workspace:^",
    "@migaia/event-subscriber": "workspace:^",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
