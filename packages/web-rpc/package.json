{
  "name": "@migai/web-rpc",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"files": ["dist"],
	"sideEffects": false,
	"dependencies": { "@migai/plugin-host": "workspace:^" },
	"engines": {"node": ">=18"},
	"type": "module",
	"description": "Type-safe RPC — schema-typed method/params/result, transport-agnostic (Worker/MessagePort/memory), full Client/Server lifecycle. No dependency on Store, React, WASM, or any specific host (DOM/Node).",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./adapters/window": {"types":"./dist/adapters/window.d.ts", "default":"./dist/adapters/window.js"},
		"./adapters/message-port": {"types":"./dist/adapters/message-port.d.ts", "default":"./dist/adapters/message-port.js"},
		"./adapters/web-worker": {"types":"./dist/adapters/web-worker.d.ts", "default":"./dist/adapters/web-worker.js"},
		"./adapters/broadcast-channel": {"types":"./dist/adapters/broadcast-channel.d.ts", "default":"./dist/adapters/broadcast-channel.js"}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:core": "tsc --noEmit -p tsconfig.core.json",
		"typecheck:node-adapter": "tsc --noEmit -p tsconfig.node-adapter.json",
		"test": "vitest run src"
	},
	"devDependencies": {
		"typescript": "~6.0.2",
		"vitest": "^4.1.10"
	}
}
