{
  "name": "@migaia/serialize",
  "version": "0.0.4",
  "private": true,
  "description": "Store-neutral chunked serialization and codec registry.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "default": "./dist/codec.js"
    },
    "./codecs/identity": {
      "types": "./dist/codecs/identity.d.ts",
      "default": "./dist/codecs/identity.js"
    },
    "./codecs/identity/v1": {
      "types": "./dist/codecs/identity/v1.d.ts",
      "default": "./dist/codecs/identity/v1.js"
    },
    "./codecs/json": {
      "types": "./dist/codecs/json.d.ts",
      "default": "./dist/codecs/json.js"
    },
    "./codecs/message-pack": {
      "types": "./dist/codecs/message-pack.d.ts",
      "default": "./dist/codecs/message-pack.js"
    },
    "./codecs/cbor": {
      "types": "./dist/codecs/cbor.d.ts",
      "default": "./dist/codecs/cbor.js"
    },
    "./codecs/protobuf": {
      "types": "./dist/codecs/protobuf.d.ts",
      "default": "./dist/codecs/protobuf.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/utils": "workspace:^",
    "@msgpack/msgpack": "3.1.3",
    "cbor-x": "1.6.6"
  },
  "devDependencies": {
    "cborg": "6.1.1",
    "msgpackr": "2.1.0",
    "protobufjs": "8.8.0",
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
