{
  "name": "@migaia/serialize",
  "version": "0.0.1",
  "private": true,
  "description": "Store-neutral chunked serialization and codec registry.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "USEGUIDE.md"],
  "main": "./dist/index.js",
