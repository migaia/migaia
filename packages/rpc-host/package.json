{
  "name": "@migaia/rpc-host",
  "version": "0.0.11",
  "private": true,
  "description": "RPC host with transport and feature plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/rpc-host"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./features": {
      "types": "./dist/features/index.d.ts",
      "default": "./dist/features/index.js"
    },
    "./features/retry": {
      "types": "./dist/features/retry.d.ts",
      "default": "./dist/features/retry.js"
    },
    "./features/timeout": {
      "types": "./dist/features/timeout.d.ts",
      "default": "./dist/features/timeout.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./plugins/typegen": {
      "types": "./dist/plugins/typegen/index.d.ts",
      "default": "./dist/plugins/typegen/index.js"
    },
    "./plugins/schema": {
      "types": "./dist/features/schema/index.d.ts",
      "default": "./dist/features/schema/index.js"
    },
    "./plugins/auth": {
      "types": "./dist/features/auth/index.d.ts",
      "default": "./dist/features/auth/index.js"
    },
    "./plugins/chunk": {
      "types": "./dist/features/chunk/index.d.ts",
      "default": "./dist/features/chunk/index.js"
    },
    "./plugins/batch": {
      "types": "./dist/features/batch/index.d.ts",
      "default": "./dist/features/batch/index.js"
    },
    "./plugins/limits": {
      "types": "./dist/features/limits/index.d.ts",
      "default": "./dist/features/limits/index.js"
    },
    "./plugins/link-policy": {
      "types": "./dist/plugins/link-policy/index.d.ts",
      "default": "./dist/plugins/link-policy/index.js"
    },
    "./plugins/idempotency": {
      "types": "./dist/features/idempotency/index.d.ts",
      "default": "./dist/features/idempotency/index.js"
    },
    "./plugins/probe": {
      "types": "./dist/plugins/probe/index.d.ts",
      "default": "./dist/plugins/probe/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks",
    "fmt": "oxfmt src test vitest.config.ts README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "lint": "oxlint src test vitest.config.ts",
    "test": "vitest run --coverage",
    "typecheck:core": "bun check -p tsconfig.core.json"
  },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/serialize": "workspace:^",
    "@migaia/supervision": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@migaia/capability": "workspace:^",
    "@types/node": "24.13.2",
    "cborg": "6.1.1",
    "elysia": "1.4.30",
    "msgpackr": "2.1.0",
    "protobufjs": "8.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
