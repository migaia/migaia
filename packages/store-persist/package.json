{
  "name": "@migaia/store-persist",
  "version": "0.0.1",
  "private": true,
  "description": "Store snapshot persistence and storage adapter protocol.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "USEGUIDE.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./light": { "types": "./dist/light-index.d.ts", "default": "./dist/light-index.js" },
    "./indexed": { "types": "./dist/indexed-index.d.ts", "default": "./dist/indexed-index.js" },
    "./keyed": { "types": "./dist/keyed-index.d.ts", "default": "./dist/keyed-index.js" }
  },
  "sideEffects": false,
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test"
  },
  "dependencies": {
    "@migaia/reactive": "workspace:^",
    "@migaia/storage-web": "workspace:^"
  },
  "peerDependencies": {
    "@migaia/store-light": "workspace:^",
    "@migaia/store-keyed": "workspace:^",
    "@migaia/store-indexed": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@migaia/store-light": { "optional": true },
    "@migaia/store-keyed": { "optional": true },
    "@migaia/store-indexed": { "optional": true }
  },
  "devDependencies": {
    "@migaia/store-light": "workspace:^",
    "@migaia/store-keyed": "workspace:^",
    "@migaia/store-indexed": "workspace:^",
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
