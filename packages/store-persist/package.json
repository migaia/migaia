{
  "name": "@migaia/store-persist",
  "version": "0.0.5",
  "private": true,
  "description": "Store snapshot persistence and storage adapter protocol.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./light": {
      "types": "./dist/light-index.d.ts",
      "default": "./dist/light-index.js"
    },
    "./indexed": {
      "types": "./dist/indexed-index.d.ts",
      "default": "./dist/indexed-index.js"
    },
    "./keyed": {
      "types": "./dist/keyed-index.d.ts",
      "default": "./dist/keyed-index.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test",
    "test:packed": "pnpm run build && node test/packed-export-smoke.mjs",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/reactive": "workspace:^",
    "@migaia/storage-contract": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@migaia/storage-web": "workspace:^",
    "@migaia/store-indexed": "workspace:^",
    "@migaia/store-keyed": "workspace:^",
    "@migaia/store-light": "workspace:^",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@migaia/store-indexed": "workspace:^",
    "@migaia/store-keyed": "workspace:^",
    "@migaia/store-light": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@migaia/store-light": {
      "optional": true
    },
    "@migaia/store-keyed": {
      "optional": true
    },
    "@migaia/store-indexed": {
      "optional": true
    }
  }
}
