{
  "name": "@migaia/reactive",
  "version": "0.0.3",
  "private": true,
  "description": "Store-neutral reactive runtime, signals, computed values, and effects.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./ownership": {
      "types": "./dist/runtime/ownership.d.ts",
      "default": "./dist/runtime/ownership.js"
    },
    "./internals": {
      "types": "./dist/runtime/internals.d.ts",
      "default": "./dist/runtime/internals.js"
    },
    "./node-internals": {
      "types": "./dist/runtime/node-internals.d.ts",
      "default": "./dist/runtime/node-internals.js"
    },
    "./node-factories": {
      "types": "./dist/runtime/node-factories.d.ts",
      "default": "./dist/runtime/node-factories.js"
    },
    "./source": {
      "types": "./dist/runtime/source.d.ts",
      "default": "./dist/runtime/source.js"
    },
    "./copy-check": {
      "types": "./dist/runtime/copy-check.d.ts",
      "default": "./dist/runtime/copy-check.js"
    },
    "./reactive/*": {
      "types": "./dist/reactive/*.d.ts",
      "default": "./dist/reactive/*.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
