{
  "name": "@migaia/utils",
  "version": "0.0.8",
  "private": true,
  "description": "Runtime-neutral reusable utility primitives.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./promise": {
      "types": "./dist/promise.d.ts",
      "default": "./dist/promise.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "default": "./dist/error.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "default": "./dist/bytes.js"
    },
    "./object": {
      "types": "./dist/object.d.ts",
      "default": "./dist/object.js"
    },
    "./object-path": {
      "types": "./dist/object-path.d.ts",
      "default": "./dist/object-path.js"
    },
    "./typing": {
      "types": "./dist/typing.d.ts",
      "default": "./dist/typing.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./function": {
      "types": "./dist/function.d.ts",
      "default": "./dist/function.js"
    },
    "./value": {
      "types": "./dist/value.d.ts",
      "default": "./dist/value.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "default": "./dist/string.js"
    },
    "./number": {
      "types": "./dist/number.d.ts",
      "default": "./dist/number.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test",
    "lint": "oxlint src test",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "test": "(node ../../scripts/dist-stamp.mjs assert || pnpm run build) && vitest run",
    "test:packed": "pnpm run build && node test/packed-export-smoke.mjs",
    "bench:collector": "pnpm run build && node test/collector-performance.mjs",
    "build": "node ../../scripts/dist-stamp.mjs clean && vite build && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/dist-stamp.mjs write",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
