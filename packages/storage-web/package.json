{
  "name": "@migaia/storage-web",
  "version": "0.0.8",
  "private": true,
  "description": "Browser backend plugins for localStorage, sessionStorage, cookies and native IndexedDB, with optional reactive queries.",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/storage-web"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local-storage": {
      "types": "./dist/local-storage.d.ts",
      "default": "./dist/local-storage.js"
    },
    "./session-storage": {
      "types": "./dist/session-storage.d.ts",
      "default": "./dist/session-storage.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "default": "./dist/cookies.js"
    },
    "./indexed-db": {
      "types": "./dist/indexed-db.d.ts",
      "default": "./dist/indexed-db.js"
    },
    "./plugins/local-storage": {
      "types": "./dist/plugins/local-storage.d.ts",
      "default": "./dist/plugins/local-storage.js"
    },
    "./plugins/session-storage": {
      "types": "./dist/plugins/session-storage.d.ts",
      "default": "./dist/plugins/session-storage.js"
    },
    "./plugins/cookies": {
      "types": "./dist/plugins/cookies.d.ts",
      "default": "./dist/plugins/cookies.js"
    },
    "./plugins/indexed-db": {
      "types": "./dist/plugins/indexed-db.d.ts",
      "default": "./dist/plugins/indexed-db.js"
    },
    "./features/reactive": {
      "types": "./dist/features/reactive.d.ts",
      "default": "./dist/features/reactive.js"
    },
    "./features/blobs": {
      "types": "./dist/features/blobs.d.ts",
      "default": "./dist/features/blobs.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "fmt": "oxfmt src test e2e README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && vite build && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "typecheck:e2e": "bun check -p tsconfig.e2e.json",
    "lint": "oxlint src test e2e",
    "test": "pnpm run build && vitest run --coverage",
    "test:packed": "pnpm run build && vitest run test/bundle-boundary.spec.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/capability": "workspace:^",
    "@migaia/event-subscriber": "workspace:^",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@migaia/reactive": "workspace:^",
    "@migaia/resource": "workspace:^",
    "@migaia/storage-contract": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/store-persist": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1"
  },
  "peerDependencies": {
    "@migaia/storage-host": "workspace:^"
  }
}
