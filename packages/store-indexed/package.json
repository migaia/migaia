{
  "name": "@migaia/store-indexed",
  "version": "0.0.3",
  "private": true,
  "description": "Indexed reactive collections with lazy cell materialization.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test e2e README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "typecheck:e2e": "bun check -p tsconfig.e2e.json",
    "lint": "oxlint src test e2e",
    "test": "vitest run test",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/reactive": "workspace:^",
    "@migaia/store-light": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "8.1.1",
    "vitest": "4.1.10"
  }
}
