{
  "name": "@migaia/tray",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "USEGUIDE.md"],
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "fmt": "oxfmt src test",
    "lint": "oxlint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
