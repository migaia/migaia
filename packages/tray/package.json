    "test": "vitest run test",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": { "@migaia/capability": "workspace:^", "@migaia/lifecycle": "workspace:^" },
  "devDependencies": { "typescript": "~6.0.2", "vitest": "4.1.10" }
