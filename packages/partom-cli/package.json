{
  "name": "@migaia/partom-cli",
  "version": "0.0.1",
  "private": true,
  "description": "partom command: doctor and extract for part-based UI projects, compiled to a single executable with Bun.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "sideEffects": false,
  "bin": {
    "partom": "./src/cli.ts"
  },
  "files": [
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "node -e \"process.exit(0)\"",
    "build:exe": "bun build src/doctor-runner.ts --target bun --external 'chromium-bidi/*' --external fsevents --outfile dist/doctor-runner.js && bun build src/preview/page/runtime.ts --target browser --format esm --outfile dist/preview-runtime.js && bun build --compile src/entry/darwin-arm64.ts --external 'chromium-bidi/*' --outfile dist/partom",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test"
  },
  "dependencies": {
    "oxc-parser": "0.154.0",
    "playwright-core": "1.62.1"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-darwin-arm64": "0.154.0",
    "@oxc-parser/binding-darwin-x64": "0.154.0",
    "@oxc-parser/binding-linux-arm64-gnu": "0.154.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.154.0",
    "@oxc-parser/binding-win32-x64-msvc": "0.154.0"
  },
  "devDependencies": {
    "@migaia/part-contract": "workspace:^",
    "@migaia/part-host": "workspace:^",
    "@migaia/part-layouts": "workspace:^",
    "@migaia/part-plugin-dom": "workspace:^",
    "@migaia/part-plugin-react": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/bun": "1.4.4",
    "@types/react": "^19.0.0",
    "@ui-sdk/core": "0.1.0-beta.7",
    "bun": "1.4.4",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^1.74.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "zod": "^4.2.0"
  }
}
