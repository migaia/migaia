{
  // Whole-package source typecheck. This package owns browser transports (Window, BroadcastChannel,
  // MessagePort, Web Streams), so it keeps the DOM library; it uses no Node or Vite types. Tests use
  // `tsconfig.test.json`, which adds their own environment and test types.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "module": "esnext",
    "types": [],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Redeclares AbortController/AbortSignal/etc. globally — collides with the
  // real ones from `lib.dom.d.ts` in this config (unlike the core proof,
  // which has no DOM lib to collide with).
  "exclude": []
}
