{
  "name": "@migaia/lifecycle",
  "version": "0.0.3",
  "private": true,
  "description": "Runtime-neutral lifecycle primitives: scopes, generations, quiescence tracking and dispose transactions.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abort": {
      "types": "./dist/abort.d.ts",
      "default": "./dist/abort.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./quiescence": {
      "types": "./dist/quiescence-tracker.d.ts",
      "default": "./dist/quiescence-tracker.js"
    },
    "./scope": {
      "types": "./dist/lifecycle-scope.d.ts",
      "default": "./dist/lifecycle-scope.js"
    },
    "./generation": {
      "types": "./dist/generation-controller.d.ts",
      "default": "./dist/generation-controller.js"
    },
    "./disposal": {
      "types": "./dist/disposal.d.ts",
      "default": "./dist/disposal.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "pnpm run build && vitest run",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
