{
  "name": "@migaia/rpc-integration",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt test bench vitest.config.ts vitest.conformance.config.ts vitest.suite-parity.config.ts vitest.family.config.ts",
    "lint": "oxlint test bench vitest.config.ts vitest.conformance.config.ts vitest.suite-parity.config.ts vitest.family.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --coverage.enabled=false",
    "test:conformance": "vitest run --config vitest.conformance.config.ts --coverage.enabled=false",
    "test:suite-parity": "vitest run --config vitest.suite-parity.config.ts --coverage.enabled=false",
    "test:packed": "pnpm --filter @migaia/rpc-contract --filter @migaia/rpc-core --filter @migaia/rpc-process --filter @migaia/rpc-threads --filter @migaia/rpc-bridge-jsonrpc --filter @migaia/rpc-browser run build && node test/core/packed-export-smoke.mjs",
    "bench:ipc": "node bench/ipc.mjs",
    "bench:probe": "node bench/probe.mjs",
    "test:coverage:family": "vitest run --config vitest.family.config.ts --coverage"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "cborg": "6.1.1",
    "elysia": "1.4.30",
    "msgpackr": "2.1.0",
    "protobufjs": "8.8.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "@migaia/capability": "workspace:^",
    "@migaia/event-subscriber": "workspace:^",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@migaia/serialize": "workspace:^",
    "@migaia/supervision": "workspace:^",
    "@migaia/utils": "workspace:^",
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/rpc-core": "workspace:*",
    "@migaia/rpc-devtools": "workspace:*",
    "@migaia/rpc-process": "workspace:*",
    "@migaia/rpc-threads": "workspace:*",
    "@migaia/rpc-bridge-jsonrpc": "workspace:*",
    "@migaia/rpc-browser": "workspace:*",
    "@playwright/test": "^1.62.1"
  }
}
