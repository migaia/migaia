{
  "name": "@migaia/rpc-integration",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt test bench vitest.config.ts vitest.conformance.config.ts vitest.suite-parity.config.ts vitest.family.config.ts",
    "lint": "oxlint test bench vitest.config.ts vitest.conformance.config.ts vitest.suite-parity.config.ts vitest.family.config.ts",
    "typecheck": "bun check -p tsconfig.test.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "test": "vitest run --coverage.enabled=false",
    "test:conformance": "vitest run --config vitest.conformance.config.ts --coverage.enabled=false",
    "test:suite-parity": "vitest run --config vitest.suite-parity.config.ts --coverage.enabled=false",
    "test:packed": "pnpm -r --workspace-concurrency=2 --filter @migaia/rpc-contract --filter @migaia/rpc-host --filter @migaia/rpc-plugin-process --filter @migaia/rpc-plugin-thread --filter @migaia/rpc-plugin-browser --filter @migaia/rpc-plugin-coroutines --filter @migaia/rpc-plugin-pool --filter @migaia/rpc-plugin-devtools run build && node test/core/packed-export-smoke.mjs",
    "bench:ipc": "node bench/ipc.mjs",
    "test:coverage:family": "vitest run --config vitest.family.config.ts --coverage"
  },
  "devDependencies": {
    "@migaia/capability": "workspace:^",
    "@migaia/event-subscriber": "workspace:^",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/plugin-host": "workspace:^",
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/rpc-host": "workspace:*",
    "@migaia/rpc-plugin-browser": "workspace:*",
    "@migaia/rpc-plugin-coroutines": "workspace:*",
    "@migaia/rpc-plugin-devtools": "workspace:*",
    "@migaia/rpc-plugin-pool": "workspace:*",
    "@migaia/rpc-plugin-process": "workspace:*",
    "@migaia/rpc-plugin-thread": "workspace:*",
    "@migaia/serialize": "workspace:^",
    "@migaia/supervision": "workspace:^",
    "@migaia/utils": "workspace:^",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.13.2",
    "cborg": "6.1.1",
    "elysia": "1.4.30",
    "msgpackr": "2.1.0",
    "protobufjs": "8.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
