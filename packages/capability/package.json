{
  "name": "@migaia/capability",
  "version": "0.0.3",
  "private": true,
  "description": "Store-neutral capability lifecycle and feature gate.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./graph/topology": {
      "types": "./dist/graph/topology.d.ts",
      "default": "./dist/graph/topology.js"
    },
    "./graph/dynamic": {
      "types": "./dist/graph/dynamic.d.ts",
      "default": "./dist/graph/dynamic.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "lint": "oxlint src test",
    "test": "vitest run test",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
