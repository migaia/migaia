{
  "name": "@migaia/capability",
  "version": "0.0.1",
  "private": true,
  "description": "Store-neutral capability lifecycle and feature gate.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./graph/topology": {
      "types": "./dist/graph/topology.d.ts",
      "default": "./dist/graph/topology.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "lint": "oxlint src test",
    "test": "vitest run test"
  },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
