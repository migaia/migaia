{
  "name": "@migaia/storage-plugin-qdrant",
  "version": "0.0.0",
  "private": true,
  "description": "Native Qdrant vector storage backend",
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "lint": "oxlint src test",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && vite build && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/dist-stamp.mjs write",
    "test": "pnpm run build && vitest run"
  },
  "dependencies": {
    "@migaia/serialize": "workspace:^",
    "@migaia/storage-contract": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@qdrant/js-client-rest": "1.11.0"
  },
  "peerDependencies": {
    "@migaia/storage-host": "workspace:^",
    "@qdrant/js-client-rest": "^1.11.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
