{
  "name": "@migaia/storage-plugin-qdrant",
  "version": "0.0.1",
  "private": true,
  "description": "Native Qdrant vector storage backend",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/storage-plugin-qdrant"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./features/hybrid": {
      "types": "./dist/features/hybrid.d.ts",
      "default": "./dist/features/hybrid.js"
    },
    "./features/recommend": {
      "types": "./dist/features/recommend.d.ts",
      "default": "./dist/features/recommend.js"
    },
    "./features/group-by": {
      "types": "./dist/features/group-by.d.ts",
      "default": "./dist/features/group-by.js"
    },
    "./features/management": {
      "types": "./dist/features/management.d.ts",
      "default": "./dist/features/management.js"
    },
    "./features/rescore": {
      "types": "./dist/features/rescore.d.ts",
      "default": "./dist/features/rescore.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "fmt": "oxfmt src test vitest.config.ts README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "lint": "oxlint src test vitest.config.ts",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && vite build && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/dist-stamp.mjs write",
    "test": "vitest run",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/serialize": "workspace:^",
    "@migaia/storage-contract": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@migaia/storage-host": "workspace:^",
    "@qdrant/js-client-rest": "1.20.0"
  },
  "peerDependencies": {
    "@migaia/storage-host": "workspace:^",
    "@qdrant/js-client-rest": "^1.18.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
