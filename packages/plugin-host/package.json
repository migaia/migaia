{
  "name": "@migaia/plugin-host",
  "version": "0.0.12",
  "private": true,
  "description": "Runtime-neutral plugin lifecycle, extension and pipeline host for Node.js, Bun, browsers and workers.",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/plugin-host"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/host-runtime.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/modules/feature-dependencies/composition-entry.d.ts",
      "default": "./dist/modules/feature-dependencies/composition-entry.js"
    },
    "./features": {
      "types": "./dist/modules/features/index.d.ts",
      "default": "./dist/modules/features/index.js"
    },
    "./enablement": {
      "types": "./dist/modules/enablement/index.d.ts",
      "default": "./dist/modules/enablement/index.js"
    },
    "./activation": {
      "types": "./dist/modules/activation/index.d.ts",
      "default": "./dist/modules/activation/index.js"
    },
    "./named-pipelines": {
      "types": "./dist/modules/named-pipelines/index.d.ts",
      "default": "./dist/modules/named-pipelines/index.js"
    },
    "./pipeline-modes/sync": {
      "types": "./dist/modules/pipeline-modes/sync.d.ts",
      "default": "./dist/modules/pipeline-modes/sync.js"
    },
    "./pipeline-modes/async": {
      "types": "./dist/modules/pipeline-modes/async.d.ts",
      "default": "./dist/modules/pipeline-modes/async.js"
    },
    "./pipeline-modes/generator": {
      "types": "./dist/modules/pipeline-modes/generator.d.ts",
      "default": "./dist/modules/pipeline-modes/generator.js"
    },
    "./pipeline-modes/async-generator": {
      "types": "./dist/modules/pipeline-modes/async-generator.d.ts",
      "default": "./dist/modules/pipeline-modes/async-generator.js"
    },
    "./feature-dependencies": {
      "types": "./dist/modules/feature-dependencies/index.d.ts",
      "default": "./dist/modules/feature-dependencies/index.js"
    },
    "./feature-overlay": {
      "types": "./dist/feature-overlay.d.ts",
      "default": "./dist/feature-overlay.js"
    },
    "./feature-overlay/notifications": {
      "types": "./dist/feature-overlay-notifications.d.ts",
      "default": "./dist/feature-overlay-notifications.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "fmt": "oxfmt src test bench vite.bench.config.ts README.md README.en.md USEGUIDE.md USEGUIDE.en.md package.json",
    "build": "node ../../scripts/dist-stamp.mjs clean && vite build && tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "lint": "oxlint src test bench vite.bench.config.ts",
    "test": "(node ../../scripts/dist-stamp.mjs assert || pnpm run build) && vitest run",
    "bench:mutation": "pnpm run build && vitest run --config vite.bench.config.ts",
    "test:packed": "pnpm run build && node test/packed-smoke.mjs",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/capability": "workspace:^",
    "@migaia/lifecycle": "workspace:^",
    "@migaia/middleware-pipeline": "workspace:^",
    "@migaia/utils": "workspace:^"
  }
}
