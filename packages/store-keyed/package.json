{
  "name": "@migaia/store-keyed",
  "version": "0.0.1",
  "private": true,
  "description": "Definition-based keyed Store state, AtomStore, family, and optics.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "USEGUIDE.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./*": { "types": "./dist/*.d.ts", "default": "./dist/*.js" },
    "./atom/*": { "types": "./dist/atom/*.d.ts", "default": "./dist/atom/*.js" },
    "./reactive/*": { "types": "./dist/reactive/*.d.ts", "default": "./dist/reactive/*.js" }
  },
  "sideEffects": false,
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test"
  },
  "dependencies": { "@migaia/lifecycle": "workspace:^", "@migaia/reactive": "workspace:^" },
  "devDependencies": { "typescript": "~6.0.2", "vitest": "4.1.10" }
}
