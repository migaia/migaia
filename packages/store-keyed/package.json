{
  "name": "@migaia/store-keyed",
  "version": "0.0.1",
  "private": true,
  "description": "Definition-based keyed Store state, AtomStore, family, and optics.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./atom/store": {
      "types": "./dist/atom/store.d.ts",
      "default": "./dist/atom/store.js"
    },
    "./atom/definition": {
      "types": "./dist/atom/definition.d.ts",
      "default": "./dist/atom/definition.js"
    },
    "./reactive/atom": {
      "types": "./dist/reactive/atom.d.ts",
      "default": "./dist/reactive/atom.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test e2e",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "oxlint src test e2e",
    "test": "vitest run test",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/reactive": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "8.1.1",
    "vitest": "4.1.10"
  }
}
