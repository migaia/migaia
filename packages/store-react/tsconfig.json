{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024", "ESNext.Disposable"],
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@migaia/resource": ["../resource/dist/index.d.ts"],
      "@migaia/store-keyed": ["../store-keyed/dist/index.d.ts"],
