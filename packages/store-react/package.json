{
  "name": "@migaia/store-react",
  "version": "0.0.1",
  "private": true,
  "description": "React Provider and hooks for the Store runtime.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "USEGUIDE.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "sideEffects": false,
  "scripts": {
    "fmt": "oxfmt src test e2e",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "oxlint src test e2e",
    "test": "vitest run test",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/reactive": "workspace:^",
    "@migaia/resource": "workspace:^",
    "@migaia/store-keyed": "workspace:^",
    "@migaia/store-light": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~6.0.2",
    "vite": "8.1.1",
    "vitest": "4.1.10"
  }
}
