{
  "name": "@migaia/store-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Worker adapters and worker-backed Resource/serialization integrations.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "USEGUIDE.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./*": { "types": "./dist/*.d.ts", "default": "./dist/*.js" },
    "./serialize/*": { "types": "./dist/serialize/*.d.ts", "default": "./dist/serialize/*.js" }
  },
  "sideEffects": false,
  "scripts": {
    "fmt": "oxfmt src test",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test",
    "test": "vitest run test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@migaia/reactive": "workspace:^",
    "@migaia/resource": "workspace:^",
    "@migaia/serialize": "workspace:^",
    "@migaia/web-rpc": "workspace:^"
  },
  "devDependencies": { "typescript": "~6.0.2", "vitest": "4.1.10" }
}
