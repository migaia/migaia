{
  "name": "@migaia/store-worker",
  "version": "0.0.2",
  "private": true,
  "description": "Worker adapters and worker-backed Resource/serialization integrations.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./serialize/*": {
      "types": "./dist/serialize/*.d.ts",
      "default": "./dist/serialize/*.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt src test e2e",
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src test e2e",
    "test": "vitest run test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  },
  "dependencies": {
    "@migaia/reactive": "workspace:^",
    "@migaia/resource": "workspace:^",
    "@migaia/rpc-contract": "workspace:^",
    "@migaia/serialize": "workspace:^",
    "@migaia/utils": "workspace:^",
    "@migaia/web-rpc": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "8.1.1",
    "vitest": "4.1.10"
  }
}
