              "payload": { "drainMs": 0 }
            }
          }
        }
      ],
      "expect": {
        "exit": 0,
        "frames": [
          { "kind": "handshake", "step": "accept" },
          { "kind": "response", "id": "echo-1", "ok": true, "data": { "payload": "still-open" } }
        ],
        "stderr": { "PEER_WARN UNKNOWN_KIND": 1 }
      }
