  "scripts": {
    "fmt": "oxfmt src test e2e bench vitest.config.ts vitest.conformance.config.ts vitest.suite-parity.config.ts",
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:contract": "tsc --noEmit -p tsconfig.contract.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint src test e2e bench vitest.config.ts vitest.conformance.config.ts vitest.suite-parity.config.ts",
    "test": "vitest run --coverage",
    "test:suite-parity": "vitest run --config vitest.suite-parity.config.ts --coverage.enabled=false",
    "test:conformance": "vitest run --config vitest.conformance.config.ts --coverage.enabled=false",
    "test:tree-shaking-baseline": "node test/core/tree-shaking-baseline.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:packed": "pnpm build && node test/core/packed-export-smoke.mjs",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks",
    "bench:ipc": "node bench/ipc.mjs"
  },
  "dependencies": {
    "@migaia/capability": "workspace:^",
    "@migaia/event-subscriber": "workspace:^",
