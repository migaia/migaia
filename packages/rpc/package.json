    "@migaia/serialize": "workspace:^",
    "@migaia/supervision": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "peerDependencies": {
    "electron": "^44.0.0",
    "koffi": "^3.1.6"
  },
  "peerDependenciesMeta": {
    "electron": { "optional": true },
    "koffi": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "24.13.2",
