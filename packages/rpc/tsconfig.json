{
  // Whole-package dev typecheck (source + tests together) — the equivalent
  // of the app's own `tsconfig.app.json`. Includes DOM lib because the
  // web-worker adapter needs it; `tsconfig.contract.json`/`tsconfig.core.json`
  // are the separate, narrower configs that prove parts of this package
  // don't actually need it. `"types": ["vite/client"]` is here only for
  // `architecture.test.ts`'s `import.meta.glob` — a devDependency-time
  // convenience for this package's own tests, not something the shipped
  // library code relies on (`tsconfig.build.json` excludes tests entirely).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Redeclares AbortController/AbortSignal/etc. globally — collides with the
  // real ones from `lib.dom.d.ts` in this config (unlike the core proof,
  // which has no DOM lib to collide with).
  "exclude": ["src/core/ambient.d.ts"]
}
