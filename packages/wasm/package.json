{
  "name": "@migaia/wasm",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src",
    "rust",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/wasm_provider.d.ts",
      "default": "./src/wasm_provider.js"
    }
