{
  "name": "@migaia/wasm",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src/wasm_provider.js",
    "src/wasm_provider.d.ts",
    "src/wasm_provider_bg.wasm",
    "src/wasm_provider_bg.wasm.d.ts",
    "rust",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/wasm_provider.d.ts",
      "default": "./src/wasm_provider.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt README.md USEGUIDE.md",
    "lint": "cargo clippy --manifest-path rust/Cargo.toml --all-targets",
    "build": "cd rust && wasm-pack build --target web --release --out-dir ../src",
    "test:rust": "cd rust && cargo test",
    "test": "wasm-pack test --node rust",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  }
}
