{
  "name": "@migaia/wasm",
  "version": "0.1.2",
  "private": true,
  "files": [
    "src/wasm_provider.js",
    "src/wasm_provider.d.ts",
    "src/wasm_provider_bg.wasm",
    "src/wasm_provider_bg.wasm.d.ts",
    "rust/src",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "README.md",
    "README.en.md",
    "USEGUIDE.md",
    "USEGUIDE.en.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/wasm_provider.d.ts",
      "default": "./src/wasm_provider.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt README.md README.en.md USEGUIDE.md USEGUIDE.en.md scripts test tsconfig.test.json",
    "lint": "cargo clippy --manifest-path rust/Cargo.toml --all-targets && oxlint scripts test",
    "build": "node ../../scripts/dist-stamp.mjs clean && cd rust && wasm-pack build --target web --release --out-dir ../src && cd .. && node scripts/finalize-glue.ts && node ../../scripts/dist-stamp.mjs write",
    "test:rust": "cd rust && cargo test",
    "test": "wasm-pack test --node rust && node --test test/initialization.test.ts",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks"
  }
}
