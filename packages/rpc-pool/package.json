{
  "name": "@migaia/rpc-pool",
  "version": "0.0.10",
  "private": true,
  "description": "Thread and process pools composed from public RPC peers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/rpc-pool"
  },
  "files": [
    "dist",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "bun check -p tsconfig.json",
    "typecheck:test": "bun check -p tsconfig.test.json",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks",
    "fmt": "oxfmt src test vitest.config.ts",
    "lint": "oxlint src test vitest.config.ts",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@migaia/lifecycle": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "devDependencies": {
    "@migaia/rpc-core": "workspace:*",
    "@migaia/rpc-process": "workspace:*",
    "@migaia/rpc-threads": "workspace:*",
    "@types/node": "24.13.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@migaia/rpc-core": "workspace:*",
    "@migaia/rpc-process": "workspace:*",
    "@migaia/rpc-threads": "workspace:*"
  },
  "peerDependenciesMeta": {},
  "engines": {
    "node": ">=24"
  }
}
