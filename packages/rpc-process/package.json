{
  "name": "@migaia/rpc-process",
  "version": "0.0.9",
  "private": true,
  "description": "RPC process owner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:kimboyeme-maker/migai.git",
    "directory": "packages/rpc-process"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "USEGUIDE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/process/index.d.ts",
      "default": "./dist/process/index.js"
    },
    "./adapters/node-child-process": {
      "types": "./dist/process/adapters/node-child-process.d.ts",
      "default": "./dist/process/adapters/node-child-process.js"
    },
    "./adapters/node-socket": {
      "types": "./dist/process/adapters/node-socket.d.ts",
      "default": "./dist/process/adapters/node-socket.js"
    },
    "./adapters/bun-spawn": {
      "types": "./dist/process/adapters/bun-spawn.d.ts",
      "default": "./dist/process/adapters/bun-spawn.js"
    },
    "./adapters/bun-socket": {
      "types": "./dist/process/adapters/bun-socket.d.ts",
      "default": "./dist/process/adapters/bun-socket.js"
    },
    "./adapters/deno-command": {
      "types": "./dist/process/adapters/deno-command.d.ts",
      "default": "./dist/process/adapters/deno-command.js"
    },
    "./adapters/deno-socket": {
      "types": "./dist/process/adapters/deno-socket.d.ts",
      "default": "./dist/process/adapters/deno-socket.js"
    },
    "./adapters/electron-utility-process": {
      "types": "./dist/process/adapters/electron-utility-process.d.ts",
      "default": "./dist/process/adapters/electron-utility-process.js"
    },
    "./adapters/windows-job": {
      "types": "./dist/process/adapters/windows-job.d.ts",
      "default": "./dist/process/adapters/windows-job.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../scripts/dist-stamp.mjs clean && tsc -p tsconfig.build.json && node ../../scripts/dist-stamp.mjs write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "release:patch": "pnpm version patch --no-git-tag-version",
    "release:pack": "pnpm pack --pack-destination /tmp",
    "release:publish": "pnpm publish --access restricted --ignore-scripts --no-git-checks",
    "fmt": "oxfmt src test vitest.config.ts",
    "lint": "oxlint src test vitest.config.ts",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@migaia/plugin-host": "workspace:^",
    "@migaia/supervision": "workspace:^",
    "@migaia/utils": "workspace:^"
  },
  "peerDependencies": {
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/rpc-core": "workspace:*",
    "electron": "^44.0.0",
    "koffi": "^3.1.6"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "koffi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@migaia/rpc-contract": "workspace:*",
    "@migaia/rpc-core": "workspace:*",
    "@migaia/serialize": "workspace:^",
    "@types/node": "24.13.2",
    "cborg": "6.1.1",
    "elysia": "1.4.30",
    "msgpackr": "2.1.0",
    "protobufjs": "8.8.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
