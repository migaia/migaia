{
  // Whole-package source typecheck against the ES library plus Node types only (no DOM). Node
  // types stay because this package owns native Node/Bun/Deno adapters; browser-only shapes are
  // structural. Tests use `tsconfig.test.json`, which adds DOM and test types.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "ESNext.Disposable"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Redeclares AbortController/AbortSignal/etc. globally — collides with the
  // real ones from `lib.dom.d.ts` in this config (unlike the core proof,
  // which has no DOM lib to collide with).
  "exclude": []
}
