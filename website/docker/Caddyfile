# Serves the prerendered site from /srv/migaia at URL prefix /migaia.
# TLS and the public hostname belong to the reverse proxy in front of this container.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	# The router basename is /migaia/, so the bare prefix must gain its slash.
	redir /migaia /migaia/ 308

	# Hashed build assets never change under the same URL.
	header /migaia/assets/* Cache-Control "public, max-age=31536000, immutable"

	# Serve a directory's index.html at the slash-less URL. A redirect to `/x/` would make
	# React Router request `/x/_.data`, which is never prerendered.
	try_files {path} {path}/index.html
	file_server {
		disable_canonical_uris
	}

	# Any path with no prerendered file gets the SPA shell with status 404. The client router
	# then renders the not-found page. Route data (`.data`) and static files keep a plain 404,
	# which React Router already reads as not found.
	handle_errors 404 {
		@page not path *.data /migaia/assets/* /migaia/pagefind/*
		rewrite @page /migaia/__spa-fallback.html
		file_server
	}
}
