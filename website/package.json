{
  "name": "migaia-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "bun run generate && react-router build && bun run search:index",
    "preview": "vite preview --outDir build/client",
    "generate": "bun scripts/generate/signatures.ts && bun scripts/generate/error-codes.ts",
    "search:index": "pagefind --site build/client",
    "fmt": "oxfmt src scripts test src/generated",
    "lint": "oxlint src scripts test",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun run test:parity && bun run test:examples && bun run test:static",
    "test:static": "bun run build && bun test test/static-route.test.ts test/toolchain-contract.test.ts test/content-quality.test.ts",
    "test:parity": "bun scripts/parity/exports.ts && bun scripts/parity/error-codes.ts && bun scripts/parity/layering.ts && bun scripts/parity/versions.ts",
    "test:examples": "bun scripts/parity/examples.ts",
    "test:browser": "node test/browser-contract.test.mjs"
  },
  "dependencies": {
    "isbot": "5.1.36",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-slot": "1.3.3",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/typography": "0.5.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.394.0",
    "oxc-transform-react": "0.147.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "pagefind": "1.1.1",
    "react-hook-form": "7.51.5",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "1.0.7",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.3.14"
}
