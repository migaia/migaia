{
  "name": "migaia-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run generate && astro build && bun run search:index",
    "preview": "astro preview",
    "generate": "bun scripts/generate/signatures.ts && bun scripts/generate/error-codes.ts",
    "search:index": "pagefind --site dist",
    "fmt": "oxfmt src scripts",
    "lint": "oxlint src scripts",
    "typecheck": "astro check && tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun run test:parity && bun run test:examples",
    "test:parity": "bun scripts/parity/exports.ts && bun scripts/parity/error-codes.ts && bun scripts/parity/layering.ts && bun scripts/parity/versions.ts",
    "test:examples": "bun scripts/parity/examples.ts"
  },
  "dependencies": {
    "@migaia/event-subscriber": "workspace:*",
    "@migaia/lifecycle": "workspace:*",
    "@migaia/logger": "workspace:*",
    "@migaia/middleware-pipeline": "workspace:*",
    "@migaia/plugin-host": "workspace:*",
    "@migaia/reactive": "workspace:*",
    "@migaia/resource": "workspace:*",
    "@migaia/serialize": "workspace:*",
    "@migaia/storage-contract": "workspace:*",
    "@migaia/storage-web": "workspace:*",
    "@migaia/utils": "workspace:*",
    "@migaia/web-rpc": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@astrojs/react": "6.0.4",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/typography": "0.5.10",
    "astro": "7.2.4",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.394.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "pagefind": "1.1.1",
    "react-hook-form": "7.51.5",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.3.3"
  },
  "packageManager": "bun@1.3.14"
}
