{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "4",
  "envMode": "loose",
  "globalDependencies": ["tsconfig.base.json", "scripts/dist-stamp.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@migaia/wasm#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/wasm_provider*", "src/.input-digest.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@migaia/wasm#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck:test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck:contract": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck:browser": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@migaia/rpc-host#typecheck:test": {
      "dependsOn": ["build", "@migaia/rpc-plugin-process#build", "@migaia/rpc-plugin-thread#build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@migaia/rpc-host#test": {
      "dependsOn": ["build", "@migaia/rpc-plugin-process#build", "@migaia/rpc-plugin-thread#build"],
      "cache": false
    },
    "@migaia/rpc-contract#typecheck:test": {
      "dependsOn": ["build", "@migaia/rpc-host#build", "@migaia/rpc-plugin-process#build"],
      "outputs": []
    },
    "@migaia/log-host#typecheck:test": {
      "dependsOn": [
        "build",
        "@migaia/log-plugin-console#build",
        "@migaia/log-plugin-durable#build",
        "@migaia/log-plugin-file#build",
        "@migaia/log-plugin-http#build",
        "@migaia/log-plugin-process#build",
        "@migaia/storage-host#build"
      ],
      "outputs": []
    },
    "@migaia/log-host#test": {
      "dependsOn": [
        "build",
        "@migaia/log-plugin-console#build",
        "@migaia/log-plugin-durable#build",
        "@migaia/log-plugin-file#build",
        "@migaia/log-plugin-http#build",
        "@migaia/log-plugin-process#build",
        "@migaia/storage-host#build"
      ],
      "cache": false
    },
    "@migaia/log-plugin-console#typecheck:test": {
      "dependsOn": [
        "build",
        "@migaia/log-plugin-http#build",
        "@migaia/log-plugin-process#build",
        "@migaia/log-plugin-reasoning#build"
      ],
      "outputs": []
    },
    "@migaia/log-plugin-console#test": {
      "dependsOn": [
        "build",
        "@migaia/log-plugin-http#build",
        "@migaia/log-plugin-process#build",
        "@migaia/log-plugin-reasoning#build"
      ],
      "cache": false
    }
  }
}
