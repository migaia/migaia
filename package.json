{
  "name": "migai",
  "private": true,
  "scripts": {
    "fmt": "pnpm -r --if-present run fmt",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:test": "pnpm -r --if-present run typecheck:test",
    "typecheck:consumers": "bun scripts/typecheck-consumers.ts",
    "test": "pnpm run build && pnpm -r run test",
    "lint": "pnpm -r --if-present run lint",
    "@logger": "pnpm --filter ./packages/logger run",
    "@event-subscriber": "pnpm --filter ./packages/event-subscriber run",
    "@web-rpc": "pnpm --filter ./packages/web-rpc run",
    "@plugin-host": "pnpm --filter ./packages/plugin-host run",
    "@storage-web": "pnpm --filter ./packages/storage-web run"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "4.9.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "6.0.2",
    "vite": "8.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@11.20.0"
}
