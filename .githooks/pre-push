#!/bin/sh
# Coverage custody must pass on the exact commit before it lands on main, so baseline drift is
# caught by the push that causes it. Owners whose inputs match the signed baseline reuse their
# numbers, so a push that changes no package finishes without running any package tests.
set -eu

zero=0000000000000000000000000000000000000000
main_push=false
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  [ "$local_sha" = "$zero" ] && continue
  main_push=true
  if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
    echo "pre-push: push main from a checkout of the pushed commit so custody measures it" >&2
    exit 1
  fi
done
"$main_push" || exit 0

if [ -n "$(git status --porcelain -- packages scripts)" ]; then
  echo "pre-push: commit or stash package and script changes; custody measures the working tree" >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"
window="$(git rev-parse --path-format=absolute --git-common-dir)/../scripts/exclusive-window.mjs"
exec node "$window" run --window pre-push-custody --wait 2700 -- \
  node scripts/storage-services.mts run -- node scripts/coverage-custody.mjs
