{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@migai/plugin-host": ["../../packages/plugin-host/dist/index.d.ts"],
      "@migai/logger": ["../../packages/logger/dist/index.d.ts"],
      "@migai/web-rpc": ["../../packages/web-rpc/dist/index.d.ts"],
      "@migai/web-rpc/*": ["../../packages/web-rpc/dist/adapters/*.d.ts"],
      "@migai/store/*": ["../../packages/store/src/*/index.ts"]
    },
    "skipLibCheck": false,
    "verbatimModuleSyntax": true
  }
}
